# Gmail OAuth (download Desktop OAuth client JSON from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# SQLite database path
DATABASE_PATH=data/outreach.db

# Templates directory (relative to working directory)
TEMPLATES_DIR=templates

# Conservative send limits — never circumvent Gmail restrictions
DAILY_SEND_LIMIT=50
HOURLY_SEND_LIMIT=10
MIN_SEND_INTERVAL_SECONDS=90

# Business-hour send window (local to SEND_TIMEZONE)
SEND_TIMEZONE=America/New_York
SEND_START_HOUR=9
SEND_END_HOUR=17

# Follow-ups: Day 0 = initial, then Day 4 and Day 9 by default
FOLLOWUP_ENABLED=true
FOLLOWUP_DAYS=0,4,9

# Safety: default dry-run. Set false only when ready for live sends with --execute
DRY_RUN=true

# Required before live campaigns (--execute)
SENDER_NAME=Your Name
SENDER_EMAIL=you@fwdconsulting.example
BUSINESS_NAME=FWD Consulting Group
BUSINESS_ADDRESS=123 Example Street, City, ST 00000
OPT_OUT_EMAIL=unsubscribe@fwdconsulting.example

# Retention guidance (days) for operational data reviews
RETENTION_DAYS=365

# Default campaign name
DEFAULT_CAMPAIGN_NAME=default

# Optional column map overrides when headers are ambiguous
# Format: normalizedheader=canonical_field;...
# Canonical fields: full_name, email, country, specialization, profile_links
# COLUMN_MAP=contactperson=full_name;mail=email
